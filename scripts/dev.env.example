# Local, machine-specific configuration for scripts/herbert-dev.sh
# Copy to scripts/dev.env (gitignored) and edit if your paths differ.
#
# On this workstation (Windows 11 host + WSL2 Ubuntu), the defaults baked into
# herbert-dev.sh already match, so scripts/dev.env is optional.

# JDK used for the Gradle build (inside WSL).
HERBERT_JAVA_HOME=/home/draygen/.local/toolchains/jdk-21.0.12.1+1

# Android SDK used for the Gradle build (inside WSL).
HERBERT_WSL_SDK=/home/draygen/.local/toolchains/android-sdk

# Android SDK installed on the WINDOWS host (emulator + AVDs live here).
# Windows-style path, and the matching path as seen from WSL.
HERBERT_WIN_SDK='C:\Users\Administrator\AppData\Local\Android\Sdk'
HERBERT_WIN_SDK_WSL=/mnt/c/Users/Administrator/AppData/Local/Android/Sdk

# Default AVD for day-to-day iteration.
HERBERT_AVD=Herbert_S24U_Dev
